{
  "name": "@ikenga/mcp-devin",
  "version": "0.2.0",
  "mcpName": "io.github.Royalti-io/ikenga-pkg-mcp-devin",
  "description": "Model Context Protocol (MCP) server that exposes the user's local Devin CLI to any Ikenga engine — single-turn runs, session listing/resume, and background task delegation.",
  "license": "Apache-2.0",
  "author": "Royalti, Inc.",
  "homepage": "https://github.com/ikenga-hq/ikenga-pkgs/tree/main/packages/mcp/devin#readme",
  "bugs": {
    "url": "https://github.com/ikenga-hq/ikenga-pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/mcp/devin"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ikenga",
    "devin",
    "cognition",
    "coding-agent",
    "ai",
    "desktop"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "devin-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test --import=tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@ikenga/contract": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
