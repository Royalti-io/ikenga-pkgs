{
  "id": "com.ikenga.engine-openrouter",
  "name": "OpenRouter Engine",
  "version": "0.1.0",
  "ikenga_api": "1",
  "kind": "engine",

  "author": {
    "name": "Royalti",
    "key": "royalti"
  },

  "ui": {},

  "permissions": {
    "net.http": ["https://openrouter.ai/api/**"],
    "fs.read": ["$pkg_data/sessions/**"],
    "fs.write": ["$pkg_data/sessions/**"]
  },

  "settings": {
    "schema": [
      {
        "key": "openrouter_api_key",
        "type": "secret",
        "label": "OpenRouter API key",
        "env": "OPENROUTER_API_KEY",
        "description": "Stored in the vault; injected into the adapter process as OPENROUTER_API_KEY (settings-secret env mechanism). Get one at https://openrouter.ai/keys."
      },
      {
        "key": "model",
        "type": "string",
        "label": "Default model",
        "default": "anthropic/claude-3.7-sonnet",
        "description": "OpenRouter model identifier, free text — any model on openrouter.ai works (e.g. anthropic/claude-3.7-sonnet, deepseek/deepseek-r1, meta-llama/llama-3.3-70b-instruct)."
      },
      {
        "key": "base_url",
        "type": "string",
        "label": "API Base URL",
        "default": "https://openrouter.ai/api/v1"
      }
    ]
  },

  "engine": {
    "agentId": "openrouter",
    "display": "OpenRouter Unified LLM",
    "capabilities": {
      "streaming": true,
      "toolUse": true,
      "thinking": true,
      "artifacts": false,
      "fileAttachments": false,
      "imageInput": false,
      "slashCommands": false,
      "modelSwitching": true,
      "promptCaching": false,
      "agenticTools": false,
      "mcp": false,
      "sessionResume": false
    },
    "onboarding": {
      "requiredVaultKeys": ["OPENROUTER_API_KEY"],
      "requiredEnvVars": [],
      "docsUrl": "https://openrouter.ai/docs"
    }
  }
}
