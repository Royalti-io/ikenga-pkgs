{
  "id": "com.ikenga.tasks",
  "name": "Tasks",
  "version": "0.6.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },

  "ui": {
    "nav": [
      {
        "id": "tasks.index",
        "label": "Tasks",
        "icon": "check-square",
        "section": "ops",
        "route": "/pkg/com.ikenga.tasks/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "style-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "font-src": ["'self'", "https://esm.sh", "data:"],
      "connect-src": [
        "'self'",
        "https://esm.sh",
        "https://*.supabase.co",
        "wss://*.supabase.co"
      ]
    }
  },

  "capabilities": {
    "sqlite": { "db": "ikenga.local" },
    "supabase": { "required": true }
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": ["https://esm.sh", "https://*.supabase.co"],
    "sqlite.tables": ["tasks"],
    "supabase.tables": ["tasks", "task_comments"],
    "vault.keys": []
  }
}
