{
  "id": "com.ikenga.mail",
  "name": "Mail",
  "version": "0.2.1",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },

  "ui": {
    "nav": [
      {
        "id": "mail.index",
        "label": "Mail",
        "icon": "mail",
        "section": "ops",
        "route": "/pkg/com.ikenga.mail/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "style-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "font-src": ["'self'", "https://esm.sh", "data:"],
      "connect-src": ["'self'", "https://esm.sh"]
    }
  },

  "capabilities": {
    "sqlite": { "db": "ikenga.local" }
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": ["https://esm.sh"],
    "sqlite.tables": [
      "email_messages",
      "email_replies",
      "email_drafts",
      "contacts",
      "mail_thread_state"
    ],
    "vault.keys": []
  },

  "requires": [
    {
      "kind": "skill",
      "name": "skill-mail"
    }
  ]
}
