{
  "id": "com.ikenga.research",
  "name": "Research",
  "version": "0.1.0",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },

  "ui": {
    "nav": [
      {
        "id": "research.index",
        "label": "Research",
        "icon": "search",
        "section": "agents",
        "route": "/pkg/com.ikenga.research/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "style-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "font-src": ["'self'", "https://esm.sh", "data:"],
      "connect-src": ["'self'", "https://esm.sh"]
    }
  },

  "capabilities": {
    "sqlite": { "db": "ikenga.local" }
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": ["https://esm.sh"],
    "sqlite.tables": [
      "research_notes",
      "research_sources",
      "sales_deals"
    ],
    "vault.keys": []
  },

  "requires": [
    {
      "kind": "skill",
      "name": "skill-research"
    }
  ]
}
