{
  "id": "com.ikenga.suite",
  "name": "Suite",
  "version": "0.1.0",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },

  "ui": {
    "nav": [
      {
        "id": "suite.index",
        "label": "Suite",
        "icon": "layout-dashboard",
        "section": "ops",
        "route": "/pkg/com.ikenga.suite/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "style-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "font-src": ["'self'", "https://esm.sh", "data:"],
      "connect-src": [
        "'self'",
        "https://esm.sh",
        "https://*.supabase.co",
        "wss://*.supabase.co"
      ]
    }
  },

  "capabilities": {
    "supabase": { "required": true }
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": ["https://esm.sh", "https://*.supabase.co"],
    "supabase.tables": [
      "tasks",
      "task_comments",
      "deals",
      "outbound_messages",
      "email_drafts"
    ],
    "vault.keys": []
  }
}
