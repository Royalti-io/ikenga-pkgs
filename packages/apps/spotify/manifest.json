{
  "id": "com.ikenga.spotify",
  "name": "Spotify for Artists",
  "version": "0.2.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },
  "ui": {
    "session": { "persistence": "keep" },
    "nav": [
      {
        "id": "spotify.index",
        "label": "Spotify",
        "icon": "music",
        "section": "apps",
        "route": "/pkg/com.ikenga.spotify/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://artists.spotify.com/",
        "partition": "persist:spotify"
      }
    ]
  },
  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": ["persist:spotify"],
      "allowed_origins": ["https://*.spotify.com", "https://accounts.spotify.com"],
      "engines": ["chrome"]
    }
  },
  "permissions": {
    "net": ["https://*.spotify.com"]
  }
}
