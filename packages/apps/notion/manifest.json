{
  "id": "com.ikenga.notion",
  "name": "Notion",
  "version": "0.2.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },
  "ui": {
    "session": { "persistence": "keep" },
    "nav": [
      {
        "id": "notion.index",
        "label": "Notion",
        "icon": "book",
        "section": "apps",
        "route": "/pkg/com.ikenga.notion/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://www.notion.so/",
        "partition": "persist:notion"
      }
    ]
  },
  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": ["persist:notion"],
      "allowed_origins": ["https://*.notion.so"],
      "engines": ["chrome"]
    }
  },
  "permissions": {
    "net": ["https://*.notion.so"]
  }
}
