{
  "id": "com.ikenga.sentry",
  "name": "Sentry",
  "version": "0.2.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },
  "ui": {
    "session": { "persistence": "keep" },
    "nav": [
      {
        "id": "sentry.index",
        "label": "Sentry",
        "icon": "activity",
        "section": "apps",
        "route": "/pkg/com.ikenga.sentry/"
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://sentry.io/",
        "partition": "persist:sentry"
      }
    ]
  },
  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": ["persist:sentry"],
      "allowed_origins": ["https://*.sentry.io"],
      "engines": ["chrome"]
    }
  },
  "permissions": {
    "net": ["https://*.sentry.io"]
  }
}
