{
  "id": "cta.subscribe",
  "kind": "cta",
  "name": "Subscribe CTA",
  "description": "Prompt a follow/subscribe action.",
  "default_renderer": "hyperframes",
  "template_path": "blocks/cta/subscribe/index.html",
  "parameters": [
    {
      "name": "platform",
      "type": "enum",
      "default": "youtube",
      "required": false,
      "enum_values": [
        "youtube",
        "tiktok",
        "instagram",
        "newsletter"
      ]
    },
    {
      "name": "label",
      "type": "string",
      "default": "Subscribe",
      "required": false
    }
  ],
  "tags": [
    "cta",
    "closer"
  ],
  "metadata": {},
  "category": "narrative",
  "default_duration_ms": 3000
}
