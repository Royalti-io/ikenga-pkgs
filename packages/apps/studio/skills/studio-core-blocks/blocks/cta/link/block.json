{
  "id": "cta.link",
  "kind": "cta",
  "name": "Link CTA",
  "description": "Drive to a URL with an end-card.",
  "default_renderer": "hyperframes",
  "template_path": "blocks/cta/link/index.html",
  "parameters": [
    {
      "name": "url",
      "type": "string",
      "default": "https://royalti.io",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "default": "Learn more",
      "required": false
    }
  ],
  "tags": [
    "cta",
    "closer"
  ],
  "metadata": {},
  "category": "narrative",
  "default_duration_ms": 3000
}
